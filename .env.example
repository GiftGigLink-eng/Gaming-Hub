# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Paystack API Keys (Server-side verification only)
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# Session configuration (Default ₦100 for 1-hour session)
SESSION_HOURLY_COST_NAIRA="100"

# LiveKit Cloud (Server-side WebRTC token generation)
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_URL="wss://livekit.gaminghub.ng"

# Private Room PIN Scrypt Secret Pepper (Min 32 characters)
ROOM_ACCESS_PEPPER="dev_gaming_hub_room_access_pepper_2026_secure_32char"

# Gaming Hub Independent Auth JWT Secret (HS256: exactly 32 cryptographically random bytes / 64 hexadecimal characters)
# Generate securely via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Server startup terminates if missing, empty, != 64 hex characters, non-hex,
# set to a known placeholder, or showing repeated patterns.
GAMING_HUB_JWT_SECRET="generate_using_crypto_randombytes_32_hex"

